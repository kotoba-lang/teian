{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM). Same runtime
 ;; kekkai/tayori ride on; a briefing/deck-drafting control plane is just
 ;; another sealed-intelligence ⊣ independent-governor StateGraph.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/json {:git/sha "4c55a247b020bfb1c7b5b09f9df8f3fa5601a207"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
        ;; canonical did:key + IPNS-name derivation (ADR-2607050100) — same
        ;; copy kekkai/tayori's CACAO issuance uses.
        io.github.kotoba-lang/ed25519
        {:sha "fdcefb9f1b83461fee54d04b63e374fa301ee847"}
        io.github.kotoba-lang/ipns
        {:sha "f2563eb1cb010c96f6dec1dfbd468fac93367498"}
        ;; teian does NOT reimplement the deck/doc/sheet EDN model — it holds
        ;; kotoba-lang/slides content verbatim as draft :content (ADR-2607062000).
        io.github.kotoba-lang/slides
        {:git/url "https://github.com/kotoba-lang/slides.git"
         :git/sha "77fd472383547627f2f8f1a1474184df8909d5be"}
        ;; real email Distributor (teian.distribute, opt-in — mock-deckport
        ;; stays the default): mailer.core builds the Resend request shape
        ;; (brings kotoba-lang/mail transitively); cheshire is the JSON codec
        ;; cloud-itonami.mail's Resend integration uses, kept identical here.
        io.github.kotoba-lang/mailer
        {:git/url "https://github.com/kotoba-lang/mailer.git"
         :git/sha "64a5e4e6f7307c582f3d0d74eca4f6cadade9a5b"}
}
 :aliases
 {;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain {:local/root "../langchain"}}}
  ;; clojure -M:dev:run  → drive a deck/doc/sheet briefing through one BriefingActor
  :run {:main-opts ["-m" "teian.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
